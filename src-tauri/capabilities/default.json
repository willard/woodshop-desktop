{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do. It may be dragged by its own header (macOS draws no title bar). The app's own commands are all allowed; plugins are limited to file dialogs, opening the data folder, the project's issue page, relaunch after an update, and the update check.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/willard/woodshop-desktop"
        },
        {
          "url": "https://github.com/willard/woodshop-desktop/*"
        }
      ]
    },
    "process:allow-restart",
    "updater:default",
    "window-state:default"
  ]
}
