{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woodshop",
  "version": "0.1.0",
  "identifier": "studio.woodshop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5317",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Woodshop",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Design furniture in 3D and get a buildable cut list.",
    "longDescription": "Woodshop is a standalone woodworking design app: model furniture part by part in 3D, check it is buildable, and get sheet layouts, a cut list, hardware and a printable plan. Everything stays on your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["woodshop"],
        "name": "Woodshop Project",
        "description": "Woodshop project file",
        "role": "Editor",
        "mimeType": "application/x-woodshop"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/OWNER/woodshop-desktop/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY"
    }
  }
}
