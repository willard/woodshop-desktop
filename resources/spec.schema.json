{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://woodshop.devlocal.ca/spec.schema.json",
    "title": "Woodshop Studio Parametric Spec",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "specVersion",
        "units",
        "name",
        "materials",
        "parts"
    ],
    "properties": {
        "specVersion": {
            "const": "1.14"
        },
        "units": {
            "const": "in",
            "description": "Internal units are always decimal inches; metric is display-only."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "materials": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "$ref": "#/$defs/material"
            }
        },
        "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
                "$ref": "#/$defs/part"
            }
        },
        "joints": {
            "type": "array",
            "maxItems": 400,
            "items": {
                "$ref": "#/$defs/joint"
            },
            "default": []
        },
        "groups": {
            "type": "array",
            "maxItems": 50,
            "items": {
                "$ref": "#/$defs/group"
            },
            "default": [],
            "description": "Editor part groups (added in 1.6): duplicate/rotate/move together. Annotations only \u2014 transform stays authoritative (\u00a73.2); flat (no nesting)."
        },
        "movables": {
            "type": "array",
            "maxItems": 50,
            "items": {
                "$ref": "#/$defs/movable"
            },
            "default": [],
            "description": "Doors and drawers (added in 1.12): annotations naming the parts that move as a unit and the hardware that carries them. The spec stores the CLOSED state; opening is a view-time transform and never mutates the spec (\u00a73.3)."
        },
        "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "difficulty": {
                    "enum": [
                        "beginner",
                        "intermediate",
                        "advanced"
                    ]
                },
                "notes": {
                    "type": "string",
                    "maxLength": 2000
                },
                "tags": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                        "type": "string",
                        "maxLength": 30
                    }
                }
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$",
            "description": "Stable slug id, e.g. p_side_l, mat_bb18"
        },
        "positiveDim": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 240,
            "description": "Decimal inches"
        },
        "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "name",
                "thickness"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "type": {
                    "enum": [
                        "sheet",
                        "lumber",
                        "round"
                    ],
                    "description": "sheet = panel stock; lumber = solid dimensional stock; round = dowel rod, sold by diameter and length (D60)."
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                },
                "thickness": {
                    "$ref": "#/$defs/positiveDim",
                    "description": "Actual thickness in inches. For type=round this is the DIAMETER \u2014 a dowel's blank is diameter x diameter x length, so one field carries it (D60)."
                },
                "sheetSize": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "l",
                        "w"
                    ],
                    "properties": {
                        "l": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "w": {
                            "$ref": "#/$defs/positiveDim"
                        }
                    },
                    "description": "Required when type=sheet"
                },
                "sheetSizes": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "l",
                            "w"
                        ],
                        "properties": {
                            "l": {
                                "$ref": "#/$defs/positiveDim"
                            },
                            "w": {
                                "$ref": "#/$defs/positiveDim"
                            }
                        }
                    },
                    "description": "Panel sizes this sheet material can actually be bought or cut from, including offcuts you already have (added in 1.14). Advisory only: the layout is still packed against `sheetSize`, but the cut list will point out when the parts would fit one of these smaller panels instead."
                },
                "stockLengths": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "$ref": "#/$defs/positiveDim"
                    },
                    "description": "Available lengths when type=lumber or type=round, e.g. [72, 96]"
                },
                "stockWidth": {
                    "$ref": "#/$defs/positiveDim"
                },
                "grain": {
                    "type": "boolean",
                    "default": true
                },
                "species": {
                    "enum": [
                        "pine",
                        "oak",
                        "maple",
                        "walnut",
                        "cherry"
                    ],
                    "description": "Wood species preset (added in 1.3); drives the renderer tint and cut-list labels. Omit for unspecified."
                },
                "costPerSheet": {
                    "type": "number",
                    "minimum": 0
                },
                "costPerBoardFoot": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "sheet"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "sheetSize"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "round"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "stockLengths"
                        ]
                    }
                }
            ]
        },
        "part": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "materialId",
                "size",
                "transform"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                },
                "materialId": {
                    "$ref": "#/$defs/id"
                },
                "size": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "l",
                        "w"
                    ],
                    "properties": {
                        "l": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "w": {
                            "$ref": "#/$defs/positiveDim"
                        }
                    },
                    "description": "Length x width of the face; thickness comes from the material."
                },
                "grainAxis": {
                    "enum": [
                        "l",
                        "w",
                        "none"
                    ],
                    "default": "l"
                },
                "transform": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "pos"
                    ],
                    "properties": {
                        "pos": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": {
                                "type": "number",
                                "minimum": -240,
                                "maximum": 240
                            },
                            "description": "Center position [x, y, z] in inches; y is up."
                        },
                        "rot": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                            },
                            "default": [
                                0,
                                0,
                                0
                            ],
                            "description": "Euler degrees (any angle; angled joinery needs exact values, so no snap grid)."
                        }
                    }
                },
                "ops": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "$ref": "#/$defs/op"
                    },
                    "default": []
                },
                "qty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 1
                },
                "locked": {
                    "type": "boolean",
                    "default": false,
                    "description": "User hand-tuned this part; AI edits must return it byte-identical."
                }
            }
        },
        "op": {
            "type": "object",
            "required": [
                "type"
            ],
            "oneOf": [
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "face",
                        "axis",
                        "offset",
                        "width",
                        "depth"
                    ],
                    "properties": {
                        "type": {
                            "enum": [
                                "dado",
                                "groove"
                            ]
                        },
                        "face": {
                            "$ref": "#/$defs/face"
                        },
                        "axis": {
                            "enum": [
                                "l",
                                "w"
                            ],
                            "description": "Direction the channel runs."
                        },
                        "offset": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Center of channel from part origin edge."
                        },
                        "width": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "depth": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Stopped channel: run start from the low run edge (w0 for axis l, l0 for axis w). Omit for a through channel."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Stopped channel: run end, same datum as `from`. Omit to run through to the far edge."
                        }
                    }
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "width",
                        "depth"
                    ],
                    "properties": {
                        "type": {
                            "const": "rabbet"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "width": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "depth": {
                            "$ref": "#/$defs/positiveDim"
                        }
                    }
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "face",
                        "x",
                        "y",
                        "diameter"
                    ],
                    "properties": {
                        "type": {
                            "const": "hole"
                        },
                        "face": {
                            "$ref": "#/$defs/face"
                        },
                        "x": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240
                        },
                        "y": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240
                        },
                        "diameter": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "depth": {
                            "$ref": "#/$defs/positiveDim"
                        },
                        "purpose": {
                            "enum": [
                                "dowel",
                                "shelfPin",
                                "hardware",
                                "other"
                            ],
                            "default": "other"
                        }
                    },
                    "description": "Omit depth for a through hole."
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "count"
                    ],
                    "properties": {
                        "type": {
                            "const": "pocketHoles"
                        },
                        "face": {
                            "$ref": "#/$defs/face",
                            "default": "back",
                            "description": "Which face the pockets are drilled from (added in 1.9); they exit the named edge either way, so this is the face the holes show on. Defaults to `back` \u2014 put them on whichever face is hidden in the assembly."
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Row start along the named edge, from the low perpendicular edge (the stopped-dado datum). Omit to spread the pockets over the whole edge."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Row end along the named edge, same datum as `from`."
                        },
                        "thread": {
                            "enum": [
                                "coarse",
                                "fine"
                            ],
                            "description": "Pocket-screw thread (added in 1.8). Coarse for softwood and sheet goods, fine for hardwood. Omit to derive from the mate's species."
                        },
                        "length": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Pocket-screw length (added in 1.8). Omit to derive from the host's thickness."
                        }
                    },
                    "description": "Marker only; no geometry subtraction. Pocket screws are driven at 15 degrees through the named edge into the mate's face."
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "face",
                        "axis",
                        "offset",
                        "count"
                    ],
                    "properties": {
                        "type": {
                            "const": "screws"
                        },
                        "face": {
                            "$ref": "#/$defs/face",
                            "description": "The face the screw heads sit on; screws drive straight through toward the opposite face."
                        },
                        "axis": {
                            "enum": [
                                "l",
                                "w"
                            ],
                            "description": "Direction the row of screws runs (same convention as a dado's run)."
                        },
                        "offset": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Distance from the low perpendicular edge to the screw line (same datum as a dado's centerline offset)."
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Row start along the run, from the low run edge (w0 for axis l, l0 for axis w). Omit to inset from both ends of the part."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Row end, same datum as `from`."
                        },
                        "gauge": {
                            "enum": [
                                "#6",
                                "#8",
                                "#10"
                            ],
                            "description": "Wood-screw gauge. Omit to derive from the mate's thickness."
                        },
                        "length": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Screw length. Omit to derive: host thickness + two thirds of the mate's."
                        }
                    },
                    "description": "Wood screws driven through this part's face into a mate behind it (added in 1.8). Marker only; no geometry subtraction."
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "angle"
                    ],
                    "properties": {
                        "type": {
                            "const": "miter"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "angle": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 60,
                            "description": "Degrees off square."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "kind",
                        "height"
                    ],
                    "properties": {
                        "type": {
                            "const": "curve"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "kind": {
                            "const": "arc"
                        },
                        "height": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Sagitta: how deep the arc cuts. With no from/to this is a DOME over the whole edge \u2014 the edge's corners drop inward by this amount while the edge midpoint stays put. With from and/or to it is a SCALLOP \u2014 the edge stays straight outside the run and dips this deep at the middle of it, leaving the corners alone. Cut through the full thickness (added in 1.4; scallops added in 1.14)."
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Partial-span arc (added in 1.14): where the scallop starts along the named edge, measured from the low perpendicular edge (w0 for l-edges, l0 for w-edges) \u2014 the stopped-dado datum (\u00a73.1). Omit BOTH from and to for the whole-edge dome. Give either and the edge runs straight outside [from, to]. A scallop leaves the edge's corners in place, so it composes with a notch on the same edge as long as their runs do not overlap."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Partial-span arc (added in 1.14): where the scallop ends, same datum as `from`. Omit to run to the far end of the edge. `height` may be at most half the run (to - from), or the arc undercuts the straight edge."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "kind",
                        "radius"
                    ],
                    "properties": {
                        "type": {
                            "const": "curve"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "kind": {
                            "const": "round"
                        },
                        "radius": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Rounds the corners of the named edge with this radius. Cut through the full thickness (added in 1.4)."
                        },
                        "corner": {
                            "$ref": "#/$defs/edge",
                            "description": "Round only the corner this edge shares with the named edge (must be perpendicular to it); omit to round both corners (added in 1.5)."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "kind",
                        "height",
                        "low"
                    ],
                    "properties": {
                        "type": {
                            "const": "curve"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "kind": {
                            "const": "ramp"
                        },
                        "height": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "One-sided sweep: the corner shared with `low` drops inward by this amount; the opposite corner keeps full size. The edge becomes an arc tangent to the original edge at the high corner. Cut through the full thickness (added in 1.5)."
                        },
                        "low": {
                            "$ref": "#/$defs/edge",
                            "description": "The adjacent (perpendicular) edge the sweep drops toward (added in 1.5)."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "from",
                        "to",
                        "depth"
                    ],
                    "properties": {
                        "type": {
                            "const": "notch"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Cutout start along the named edge, measured from the low perpendicular edge (w0 for l-edges, l0 for w-edges) \u2014 the stopped-dado datum (\u00a73.1). from < to; from = 0 makes a corner notch at the low corner (added in 1.7)."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Cutout end along the named edge, same datum. to = the edge's full length makes a corner notch at the high corner (added in 1.7)."
                        },
                        "depth": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "How far the cutout reaches into the part from the named edge; must be less than the perpendicular span. Cut through the full thickness (added in 1.7)."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "profile",
                        "radius"
                    ],
                    "properties": {
                        "type": {
                            "const": "ease"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "profile": {
                            "const": "roundover"
                        },
                        "radius": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Router roundover radius on the named edge's arris (added in 1.10). Eats into the thickness, never into the blank: `radius` <= thickness/2 when both arrises are eased, <= thickness for one."
                        },
                        "face": {
                            "$ref": "#/$defs/face",
                            "description": "Ease only the arris on this face. Omit to soften the edge from both faces (the usual router pass down each side)."
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run start along the named edge, measured from the low perpendicular edge (w0 for l-edges, l0 for w-edges) \u2014 the stopped-dado datum (\u00a73.1). Omit to start at the edge's end (added in 1.11)."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run end, same datum as `from`. Omit to run out the far end. A stopped end gets a short taper where the bit leaves the cut (added in 1.11)."
                        }
                    },
                    "description": "Soft edge cut with a router: the sharp arris between the named edge and a face becomes a quarter-round."
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "profile",
                        "width"
                    ],
                    "properties": {
                        "type": {
                            "const": "ease"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "profile": {
                            "const": "chamfer"
                        },
                        "width": {
                            "$ref": "#/$defs/positiveDim",
                            "description": "Leg of the 45 degree chamfer on the named edge's arris (added in 1.10); same thickness bounds as a roundover radius."
                        },
                        "face": {
                            "$ref": "#/$defs/face",
                            "description": "Ease only the arris on this face. Omit to chamfer from both faces."
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run start along the named edge, measured from the low perpendicular edge (w0 for l-edges, l0 for w-edges) \u2014 the stopped-dado datum (\u00a73.1). Omit to start at the edge's end (added in 1.11)."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run end, same datum as `from`. Omit to run out the far end. A stopped end gets a short taper where the bit leaves the cut (added in 1.11)."
                        }
                    },
                    "description": "Soft edge cut with a chamfer bit: the arris is knocked off at 45 degrees."
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "edge",
                        "profile"
                    ],
                    "properties": {
                        "type": {
                            "const": "ease"
                        },
                        "edge": {
                            "$ref": "#/$defs/edge"
                        },
                        "profile": {
                            "const": "bullnose"
                        },
                        "from": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run start along the named edge, measured from the low perpendicular edge (w0 for l-edges, l0 for w-edges) \u2014 the stopped-dado datum (\u00a73.1). Omit to start at the edge's end (added in 1.11)."
                        },
                        "to": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 240,
                            "description": "Stopped ease: run end, same datum as `from`. Omit to run out the far end. A stopped end gets a short taper where the bit leaves the cut (added in 1.11)."
                        }
                    },
                    "description": "Full half-round on the named edge (added in 1.10): both arrises rounded at thickness/2, so the edge becomes a semicircle. Takes no size and no face \u2014 the stock thickness decides both."
                }
            ]
        },
        "face": {
            "enum": [
                "front",
                "back"
            ],
            "description": "Local-frame faces only: front = +Z, back = -Z (thickness axis). Assembly orientation comes from transform, never from face names."
        },
        "edge": {
            "enum": [
                "l0",
                "l1",
                "w0",
                "w1"
            ],
            "description": "Edges along length (l0/l1) or width (w0/w1)."
        },
        "joint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "hostPartId",
                "insertPartId"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id",
                    "description": "Stable joint id (added in 1.14). Optional so pre-1.14 documents still read, but every joint the app or a tool writes has one \u2014 address joints by id, not by their position in the array, which shifts as joints are removed."
                },
                "type": {
                    "enum": [
                        "dado",
                        "rabbet",
                        "butt",
                        "pocketScrew",
                        "screw",
                        "dowel"
                    ]
                },
                "hostPartId": {
                    "$ref": "#/$defs/id"
                },
                "insertPartId": {
                    "$ref": "#/$defs/id"
                },
                "opRef": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Index into hostPart.ops that this joint uses, when applicable."
                }
            }
        },
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "partIds"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                },
                "partIds": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/id"
                    },
                    "description": "Member part ids; a group always has at least two members."
                }
            }
        },
        "movable": {
            "type": "object",
            "required": [
                "kind"
            ],
            "oneOf": [
                {
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "kind",
                        "partIds",
                        "panelPartId",
                        "hingeEdge",
                        "style"
                    ],
                    "properties": {
                        "id": {
                            "$ref": "#/$defs/id"
                        },
                        "kind": {
                            "const": "door"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                        },
                        "partIds": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 20,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/$defs/id"
                            },
                            "description": "Every part that swings with the door (the panel plus battens, cleats, wooden pulls). Must include panelPartId."
                        },
                        "panelPartId": {
                            "$ref": "#/$defs/id",
                            "description": "The panel whose local frame defines the hinge; must be listed in partIds."
                        },
                        "hingeEdge": {
                            "$ref": "#/$defs/edge",
                            "description": "The panel edge the hinges mount on, in the panel's LOCAL frame (\u00a73.1). The hinge line is that edge's front (+Z) arris; the door swings its free edge toward the panel's front face."
                        },
                        "style": {
                            "enum": [
                                "overlay",
                                "inset"
                            ],
                            "description": "Overlay laps the opening by the overlay allowance per side; inset sits inside it behind a reveal. Drives preset sizing and hinge selection only \u2014 transform stays authoritative."
                        }
                    },
                    "description": "A hinged door: swings on the front arris of the named panel edge (\u00a73.3)."
                },
                {
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "kind",
                        "partIds",
                        "frontPartId",
                        "style"
                    ],
                    "properties": {
                        "id": {
                            "$ref": "#/$defs/id"
                        },
                        "kind": {
                            "const": "drawer"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                        },
                        "partIds": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 20,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/$defs/id"
                            },
                            "description": "Every part that slides with the drawer (front, box sides, back, bottom). Must include frontPartId."
                        },
                        "frontPartId": {
                            "$ref": "#/$defs/id",
                            "description": "The drawer front; its local +Z (front-face normal, \u00a73.1) is the pull-out direction. Must be listed in partIds."
                        },
                        "style": {
                            "enum": [
                                "overlay",
                                "inset"
                            ]
                        }
                    },
                    "description": "A drawer riding side-mount slides: pulls out along the front's face normal (\u00a73.3)."
                }
            ]
        }
    }
}
