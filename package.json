{
  "name": "woodshop-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm && tsc --noEmit -p ui && vite build",
    "build:release": "npm run build:viewer && npm run build",
    "build:viewer": "npm run wasm:viewer && vite build --config viewer/vite.config.ts",
    "wasm": "wasm-pack build crates/woodshop-wasm --target web --release --out-dir ../../ui/src/domain/wasm --out-name woodshop",
    "wasm:viewer": "wasm-pack build crates/woodshop-wasm --target web --release --out-dir ../../viewer/src/wasm --out-name woodshop -- --no-default-features",
    "spec:generate": "node ui/src/spec/generate-zod.mjs",
    "typecheck": "tsc --noEmit -p ui",
    "lint": "eslint ui/src viewer/src e2e playwright.config.ts",
    "format:check": "prettier --check ui/src viewer/src e2e playwright.config.ts",
    "format": "prettier --write ui/src viewer/src e2e playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "json-schema-to-zod": "^2.8.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
